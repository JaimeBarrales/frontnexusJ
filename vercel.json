{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:ruta*", "destination": "https://52-1-100-14.sslip.io/api/:ruta*" },
    { "source": "/health", "destination": "https://52-1-100-14.sslip.io/health" },
    { "source": "/config.json", "destination": "https://52-1-100-14.sslip.io/config.json" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
